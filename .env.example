# Cyber Autopsy — environment configuration.
# Copy to .env and fill in only what you need. Never commit real keys.

# Kaggle API token (https://www.kaggle.com/settings -> API)
# Current CLI accepts a KGAT_ token directly.
KAGGLE_API_TOKEN=

# Written automatically by `kaggle b init -y` (short-lived; refresh with
# `kaggle b auth -y`). Do not fill in manually.
# MODEL_PROXY_URL=
# MODEL_PROXY_API_KEY=
# LLM_DEFAULT=
# LLMS_AVAILABLE=

# Set after the Cyber Autopsy benchmark is composed on kaggle.com.
# Never fabricate — leave empty until the benchmark actually exists.
KAGGLE_BENCHMARK_URL=
KAGGLE_BENCHMARK_ID=

# Demo mode: when true, the research UI serves precomputed results only.
DEMO_MODE=true

# Existing Sanity project used by the Studio and investigation agent.
SANITY_PROJECT_ID=41l9o4xn
SANITY_DATASET=production
# Required only for `npm run sanity:seed`; never expose this to the browser.
SANITY_API_TOKEN=
# Official hosted Sanity Context MCP endpoint and organization token.
# Create both in Sanity Manage > Context. Never commit the token.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/oqf9m6vy6/mcp/cyber-autopsy-context
SANITY_CONTEXT_TOKEN=
SANITY_ORG_TOKEN=
SANITY_CONTEXT_KB_ID=kbZHPSeMHnZt
# Optional local UI port.
PORT=3000
